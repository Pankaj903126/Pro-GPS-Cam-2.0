# Release Keystore Configuration Example
# Copy this file to 'keystore.properties' in the project root directory and fill in your actual credentials.
# DO NOT commit your actual 'keystore.properties' or '.jks' key files to source control.

storeFile=my-release-key.jks
storePassword=YOUR_STORE_PASSWORD
keyAlias=YOUR_KEY_ALIAS
keyPassword=YOUR_KEY_PASSWORD
